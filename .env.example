# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
# Copy this file to .env.local and paste your key.
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Optional: thinking depth — MINIMAL | LOW | MEDIUM | HIGH (defaults to LOW).
# Higher = deeper reasoning but slower; LOW keeps audits well under the timeout.
# GEMINI_THINKING_LEVEL=LOW
